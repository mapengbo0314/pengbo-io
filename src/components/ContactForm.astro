---
// ponytail: FormSubmit — static-site form relay to EMAIL, no backend to run
import { EMAIL } from '../consts';

const inputClass =
  'w-full rounded-md border border-border bg-surface px-4 py-3 text-[15px] placeholder:text-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent';
---

<form action={`https://formsubmit.co/${EMAIL}`} method="POST" class="max-w-[60ch] space-y-6">
  <input type="hidden" name="_subject" value="pengbo-io.com — new contact" />
  <input type="hidden" name="_next" value="https://pengbo-io.com/thanks" />
  <input type="hidden" name="_captcha" value="false" />
  <input type="text" name="_honey" class="hidden" tabindex="-1" autocomplete="off" />

  <div>
    <label for="name" class="text-sm font-medium">Name</label>
    <input id="name" name="name" type="text" required class={`mt-2 ${inputClass}`} />
  </div>
  <div>
    <label for="email" class="text-sm font-medium">Email</label>
    <input id="email" name="email" type="email" required class={`mt-2 ${inputClass}`} />
  </div>
  <div>
    <label for="product" class="text-sm font-medium">
      Product URL <span class="font-normal text-muted">(optional)</span>
    </label>
    <input id="product" name="product" type="url" placeholder="https://" class={`mt-2 ${inputClass}`} />
  </div>
  <div>
    <label for="message" class="text-sm font-medium">What's going on?</label>
    <textarea
      id="message"
      name="message"
      rows="6"
      required
      class={`mt-2 ${inputClass}`}
      placeholder="What you built, how you deploy today, and what worries you."></textarea>
  </div>
  <button type="submit" class="btn-primary">Send message</button>
</form>
