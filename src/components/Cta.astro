---
import Eyebrow from './Eyebrow.astro';
import { CAL_LINK, EMAIL } from '../consts';

const inputClass =
  'w-full rounded-md border border-border bg-surface px-4 py-3 text-[15px] placeholder:text-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent';
---

<section id="book" class="border-t border-border">
  <div class="mx-auto max-w-5xl px-6 py-24">
    <Eyebrow text="06 — Get in touch" />
    <h2 class="mt-6 font-display text-3xl [font-weight:500] md:text-4xl">Make production boring.</h2>
    <p class="mt-4 max-w-[60ch] text-lg leading-relaxed text-muted">
      A 30-minute call. We'll ask how you ship today, tell you honestly whether the diagnostic week
      is worth your money, and you'll leave with at least one thing to fix either way.
    </p>
    <div class="mt-8">
      <a href={CAL_LINK} class="btn-primary">Book a 30-minute intro call</a>
    </div>

    {/* ponytail: quick two-field contact — the full form lives at /contact */}
    <form
      action={`https://formsubmit.co/${EMAIL}`}
      method="POST"
      class="mt-10 flex max-w-[68ch] flex-col gap-3 sm:flex-row"
    >
      <input type="hidden" name="_subject" value="pengbo-io.com — quick contact" />
      <input type="hidden" name="_next" value="https://pengbo-io.com/thanks?sent=1" />
      <input type="hidden" name="_captcha" value="false" />
      <input type="text" name="_honey" class="hidden" tabindex="-1" autocomplete="off" />
      <label class="sr-only" for="quick-email">Email</label>
      <input
        id="quick-email"
        name="email"
        type="email"
        required
        placeholder="you@company.com"
        class={`${inputClass} sm:max-w-56`}
      />
      <label class="sr-only" for="quick-message">Message</label>
      <input
        id="quick-message"
        name="message"
        type="text"
        required
        placeholder="Or skip the call — what's going on?"
        class={inputClass}
      />
      <button type="submit" class="btn-secondary shrink-0">Send</button>
    </form>
    <p class="mt-4 font-mono text-sm text-muted">
      or email <a
        href={`mailto:${EMAIL}`}
        class="underline decoration-1 underline-offset-4 transition-colors duration-150 hover:text-text"
        >{EMAIL}</a
      >
    </p>
  </div>
</section>
