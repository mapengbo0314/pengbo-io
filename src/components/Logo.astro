---
// PBM monogram "Bowl Light" — stem + two bowls (P + B, m silhouette), green status dot.
// Always decorative here: it sits next to the "Pengbo IO" wordmark text.
interface Props {
  class?: string;
}
const { class: className = 'h-8 w-8' } = Astro.props;
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" class={className} aria-hidden="true">
  <rect x="2" y="2" width="60" height="60" rx="14" fill="#14171F"></rect>
  <circle cx="32.5" cy="40" r="4.5" fill="#34D399"></circle>
  <path
    d="M24 15v34M24 15h7a8 8 0 0 1 0 16h-7M24 31h8a9 9 0 0 1 0 18h-8"
    fill="none"
    stroke="#FAF9F6"
    stroke-width="8"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
</svg>
