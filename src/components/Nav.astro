---
import { CAL_LINK } from '../consts';

const links = [
  ['#problem', 'The problem'],
  ['#offer', 'What we install'],
  ['#plan', 'The plan'],
  ['#faq', 'FAQ'],
];
---

<header class="border-b border-border">
  <nav class="mx-auto flex h-16 max-w-5xl items-center justify-between px-6">
    <a href="/" class="font-display text-xl [font-weight:500]">Pengbo IO</a>
    <div class="flex items-center gap-8">
      <div class="hidden items-center gap-8 md:flex">
        {
          links.map(([href, label]) => (
            <a
              href={href}
              class="text-[15px] font-medium text-muted transition-colors duration-150 hover:text-text"
            >
              {label}
            </a>
          ))
        }
      </div>
      {/* ghost style — the hero owns the viewport's single primary button */}
      <a href={CAL_LINK} class="btn-secondary !px-4 !py-2">Book intro call</a>
    </div>
  </nav>
</header>
