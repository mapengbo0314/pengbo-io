---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Eyebrow from '../components/Eyebrow.astro';
import ContactForm from '../components/ContactForm.astro';
import { CAL_LINK, EMAIL } from '../consts';

---

<Layout title="Contact — Pengbo IO">
  <Nav />
  <main class="mx-auto max-w-5xl px-6 py-24">
    <Eyebrow text="Contact" />
    <h1 class="mt-6 font-display text-4xl [font-weight:500] md:text-5xl">Tell us how you ship.</h1>
    <p class="mt-6 max-w-[60ch] text-lg leading-relaxed text-muted">
      A few sentences about your product and how deploys work today is plenty. We read everything
      and get back to you as soon as possible. Prefer talking? <a
        href={CAL_LINK}
        class="underline decoration-1 underline-offset-4 transition-colors duration-150 hover:text-text"
        >Book a 30-minute call</a
      > instead.
    </p>

    <div class="mt-12">
      <ContactForm />
    </div>

    <p class="mt-10 font-mono text-sm text-muted">
      or email directly: <a
        href={`mailto:${EMAIL}`}
        class="underline decoration-1 underline-offset-4 transition-colors duration-150 hover:text-text"
        >{EMAIL}</a
      >
    </p>
  </main>
  <Footer />
</Layout>
