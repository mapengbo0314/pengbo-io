---
import Layout from '../../layouts/Layout.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import Wordmark from '../../components/Wordmark.astro';
---

<Layout title="Logo — Pengbo IO design system">
  <main class="mx-auto max-w-5xl space-y-16 px-6 py-16">
    <section>
      <Eyebrow text="Logo — PBM tile" />
      <p class="mt-2 max-w-[68ch] text-sm text-muted">
        Real Fraunces (opsz 144, wght 600) letterforms baked to paths — no font dependency, renders
        identically everywhere. Green period is the “status ok” brand accent. Dark terminal tile,
        fixed in both modes.
      </p>
      <div class="mt-8 flex items-end gap-8">
        <div><img src="/favicon.svg" class="h-16 w-16" alt="" /><p class="mt-2 font-mono text-xs text-muted">64</p></div>
        <div><img src="/favicon.svg" class="h-8 w-8" alt="" /><p class="mt-2 font-mono text-xs text-muted">32</p></div>
        <div><img src="/favicon.svg" class="h-6 w-6" alt="" /><p class="mt-2 font-mono text-xs text-muted">24</p></div>
        <div><img src="/favicon.svg" class="h-4 w-4" alt="" /><p class="mt-2 font-mono text-xs text-muted">16 · favicon</p></div>
      </div>
    </section>

    <section>
      <Eyebrow text="Wordmark — nav" />
      <p class="mt-2 max-w-[68ch] text-sm text-muted">
        Letters follow currentColor (adapts to light/dark); the period stays green.
      </p>
      <div class="mt-6 space-y-4">
        <div class="rounded-lg border border-border bg-surface p-6">
          <Wordmark class="h-5 w-auto" />
        </div>
        <div class="rounded-lg bg-term-bg p-6 text-term-text">
          <Wordmark class="h-5 w-auto" />
        </div>
        <div class="rounded-lg border border-border bg-surface p-6">
          <Wordmark class="h-10 w-auto" />
        </div>
      </div>
    </section>

    <section>
      <Eyebrow text="Alternates — archived" />
      <p class="mt-2 max-w-[68ch] text-sm text-muted">
        Paper-seal, ink-tile, and mono-tile variants plus the retired abstract mark live in
        <span class="font-mono">design/exploration/logo-v2/</span> in the repo.
      </p>
    </section>
  </main>
</Layout>
