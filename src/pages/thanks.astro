---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Eyebrow from '../components/Eyebrow.astro';
import { CAL_LINK } from '../consts';
---

<Layout title="Message sent — Pengbo IO">
  <Nav />
  <main class="mx-auto max-w-5xl px-6 py-24">
    <Eyebrow text="Sent" />
    <h1 class="mt-6 font-display text-4xl [font-weight:500] md:text-5xl">
      Got it. We'll reply within a day.
    </h1>
    <p class="mt-6 max-w-[60ch] text-lg leading-relaxed text-muted">
      Want to skip the back-and-forth? Grab a slot now and we'll do the first conversation live.
    </p>
    <div class="mt-8">
      <a href={CAL_LINK} class="btn-primary">Book a 30-minute intro call</a>
    </div>
  </main>
  <Footer />
</Layout>
